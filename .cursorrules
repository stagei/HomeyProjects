## Common Patterns & Anti-Patterns

### ✅ CORRECT Patterns

```javascript
// Accessing Homey managers
this.homey.settings.get('key');
this.homey.flow.getActionCard('id');
this.homey.images.createImage();

// Async/await everywhere
async onInit() {
  await this.setupDevice();
}

// Capability handling
this.registerCapabilityListener('onoff', async (value) => {
  await this.device.setPower(value);
});

// Error handling with availability
try {
  const data = await this.fetchData();
  await this.setCapabilityValue('measure_temperature', data.temp);
  await this.setAvailable();
} catch (error) {
  this.error('Fetch failed:', error);
  await this.setUnavailable('Connection failed');
}

// Unique device ID in pairing
return { data: { id: device.serialNumber } };

// Store for credentials
await this.setStoreValue('token', accessToken);
```

### ❌ WRONG Patterns (Never Use)

```javascript
// DON'T import managers directly (SDK v2 style)
const ManagerSettings = require('homey').ManagerSettings;  // WRONG!

// DON'T use callbacks (SDK v2 style)
onInit(callback) { callback(); }  // WRONG!

// DON'T forget async/await
this.setCapabilityValue('onoff', true);  // WRONG - missing await!

// DON'T store credentials in settings (visible to user)
await this.setSettings({ token: secret });  // WRONG - use setStoreValue!

// DON'T use non-unique device IDs
return { data: { id: '1' } };  // WRONG - must be unique!

// DON'T ignore errors
await this.sendCommand(value);  // WRONG - wrap in try/catch!
```

