## Code Templates

### Basic App (app.js)
```javascript
'use strict';
const Homey = require('homey');

class MyApp extends Homey.App {
  async onInit() {
    this.log('App initialized');
  }
}

module.exports = MyApp;
```

### Basic Driver (driver.js)
```javascript
'use strict';
const Homey = require('homey');

class MyDriver extends Homey.Driver {
  async onInit() {
    this.log('Driver initialized');
  }

  async onPairListDevices() {
    return [];
  }
}

module.exports = MyDriver;
```

### Basic Device (device.js)
```javascript
'use strict';
const Homey = require('homey');

class MyDevice extends Homey.Device {
  async onInit() {
    this.log('Device initialized');
    this.registerCapabilityListener('onoff', this.onCapabilityOnoff.bind(this));
  }

  async onCapabilityOnoff(value) {
    this.log('onoff:', value);
  }
}

module.exports = MyDevice;
```

### Zigbee Device
```javascript
'use strict';
const { ZigBeeDevice } = require('homey-zigbeedriver');
const { CLUSTER } = require('zigbee-clusters');

class MyZigbeeDevice extends ZigBeeDevice {
  async onNodeInit({ zclNode }) {
    this.registerCapability('onoff', CLUSTER.ON_OFF);
  }
}

module.exports = MyZigbeeDevice;
```

### Z-Wave Device
```javascript
'use strict';
const { ZwaveDevice } = require('homey-zwavedriver');

class MyZwaveDevice extends ZwaveDevice {
  async onNodeInit() {
    this.registerCapability('onoff', 'SWITCH_BINARY');
  }
}

module.exports = MyZwaveDevice;
```

### API Endpoint (api.js)
```javascript
'use strict';

module.exports = {
  async getStatus({ homey }) {
    return { status: 'ok' };
  },
  
  async postUpdate({ homey, body }) {
    homey.settings.set('lastUpdate', body.data);
    return { success: true };
  }
};
```

